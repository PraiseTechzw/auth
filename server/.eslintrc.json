{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {}
  ,
  "overrides": [
    {
      "files": ["src/**/*.js"],
      "rules": {
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
      }
    }
  ]
}
